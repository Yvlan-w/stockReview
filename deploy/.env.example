# ============================================================
# 部署环境变量模板：复制为 .env 后填写（.env 不入 git / 不入镜像）
#   cp .env.example .env
# ============================================================

# ---- 镜像地址（阶段二开通 ACR 后替换为真实地址）----
# 格式：registry.<地域>.aliyuncs.com/<命名空间>/<仓库名>:<tag>
IMAGE=registry.cn-hangzhou.aliyuncs.com/your-namespace/stock-review:v0.1.0

# ---- JWT 密钥（必填；生成方式见下，或用 build-push.ps1 自动生成的值）----
# PowerShell 生成：-join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
# Linux 生成：     openssl rand -hex 24
STOCK_REVIEW_SECRET=change-me-to-a-random-48-char-string

# ---- 种子执行模式（生产建议 first 或 never）----
#   never  = 永不执行 seed（生产稳定后锁定；如果库中本来就无 admin，请先把值改成 first 启动一次再切 never）
#   first  = 仅当 users + clients 双空时才创建 admin 1 个账号（生产默认）
#   always = 总是幂等建 admin（admin 已存在则跳过，不影响任何其他数据）
STOCK_REVIEW_RUN_SEED=first

# ---- admin 初始密码（仅首次建号时读取；已存在 admin 则忽略）----
# STOCK_REVIEW_ADMIN_PASSWORD=jdzt123456

# ---- 登录 Token 有效期（分钟，默认 720 = 12 小时）----
STOCK_REVIEW_TOKEN_TTL=720

# ---- 宿主机监听端口（默认 8000，正式环境换 80/443 时改这里）----
HOST_PORT=8000
