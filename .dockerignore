# ============================================================
# 持仓复盘 · Docker 构建上下文严格过滤清单
# ------------------------------------------------------------
# 设计原则：
#   1) 「最小白名单思维」——生产运行真正需要的文件只有 4 类：
#        backend/requirements.txt、backend/app/**（除 commands/）、
#        backend/run.py、frontend/**
#      其余全部在此文件中显式排除。
#   2) 既减少 docker daemon 接收的上下文体积（加速构建、稳定缓存），
#      又防止将来有人在 COPY backend/ 场景下把测试/文档带进去。
#   3) 避免使用「全局排除 + !例外放行」的复杂写法（经验教训：易造成
#      规则冲突与维护成本），直接用黑名单逐项列出风险类别。
#   4) deploy/Dockerfile 本身由 docker build -f 显式指定，不受
#      本文件 deploy/ 排除规则影响（Docker 原生机制保证）。
# ============================================================

# ============================================================
# 【类别 1】Python 编译产物 & 解释器缓存（已含原规则，加固通配）
# ============================================================
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.pytest_cache/
**/*.egg-info/
**/.installed.cfg
lib/
lib64/
develop-eggs/
parts/
sdist/
var/

# ============================================================
# 【类别 2】测试代码 & 覆盖率报告（关键遗漏：原规则缺少 tests/）
# 运行时绝不需要；混入上下文会导致「改一行测试代码就全量重装 pip 依赖」
# ============================================================
backend/tests/
backend/**/test_*.py
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.tox/
.nox/

# ============================================================
# 【类别 3】本地 Python 虚拟环境（关键遗漏：原规则 0 覆盖）
# 本地 venv 可达 200~500MB，一旦被上下文传入会严重拖慢构建、
# 污染层缓存（任何 venv 内文件时间戳变动都使 cache key 失效）
# ============================================================
backend/venv/
backend/.venv/
backend/env/
venv/
.venv/
.env/

# ============================================================
# 【类别 4】IDE / 编辑器 / OS 自动生成的垃圾文件（原规则缺 IDE 类）
# .gitignore 有但 .dockerignore 没有 = 构建上下文仍然携带它们
# ============================================================
.vscode/
.idea/
.project
.settings/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.history/

# macOS / Windows 系统文件
**/.DS_Store
**/.Spotlight-V100
**/.Trashes
**/ehthumbs.db
**/Thumbs.db
**/Thumbs.db:encryptable
**/desktop.ini

# ============================================================
# 【类别 5】Git 元数据（原规则已含，加固）
# ============================================================
.git/
.gitignore
.gitattributes
.gitmodules
.github/

# ============================================================
# 【类别 6】SQLite / 本地数据库文件（原规则已含，扩展兜底）
# 绝对禁止出现在镜像中，避免「新镜像自带空数据库覆盖生产卷」的误解
# ============================================================
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite3
backend/data/
data/

# ============================================================
# 【类别 7】日志、错误输出、临时痕迹文件（原规则有，扩展）
# ============================================================
**/*.log
**/*.err
**/*.tmp
**/*.bak
**/backend_err.log
deploy_history/

# ============================================================
# 【类别 8】文档 / 说明 / 交付物资料（原 *.md 规则有，显式扩展中文命名兜底）
# ============================================================
docs/
**/*.md
项目交接文档.md
重新部署实施计划.md

# ============================================================
# 【类别 9】示例 HTML / 报告渲染开发模板 / 分享快照产物（原规则有，扩展）
# ============================================================
持仓复盘_分享版_*.html
*示例*.html
*demo*.html
*public*.html
_templates/
持仓复盘_分享版_*

# ============================================================
# 【类别 10】后端运维 / 修复 / 一次性脚本集合（原规则有，扩展 3 个遗漏脚本）
# ============================================================
backend/scripts/
backend/_*.py
backend/_*.txt
# 排除 backend 目录下所有 .txt (临时输出/日志/报告)，**唯一例外**：requirements.txt 是 pip 部署必需
# （注：! 反向例外必须放在 backend/*.txt 排除规则之后，Docker 顺序匹配后者覆盖前者）
backend/*.txt
!backend/requirements.txt
backend/=
backend/import_klines.py
backend/refresh_prices.py
backend/verify_strategy_review_tracking.py
backend/app/commands/

# ============================================================
# 【类别 11】本地 / 部署环境配置与交付辅助脚本（原 deploy 规则有，加固）
# ============================================================
deploy/
.env
.env.local
deploy/.env.*
*.tar
*.tar.gz
*.zip

# ============================================================
# 【类别 12】前端开发辅助 / 构建临时（当前项目无 npm 打包，但防未来扩展）
# ============================================================
node_modules/
jspm_packages/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/js/**/*.map

# ============================================================
# 【类别 13】本地开发辅助 / 模拟 / 草稿文件（原规则 0 覆盖，新增）
# ============================================================
.sim_modules.mjs
.smoke-upgrade.stamp
deploy/.smoke-upgrade.stamp
workbuddy/
.workbuddy/
sim_modules/

# ============================================================
# 【类别 14】构建中间产物 / 发布归档
# ============================================================
dist/
build/
target/
eggs/
share/python-wheels/
pip-wheel-metadata/

# ============================================================
# 【类别 15】安全兜底：任何密钥 / 凭证 / 备份
# ============================================================
*.pem
*.key
*password*.bak
*secret*.bak
credentials.json

# ============================================================
# 【类别 16】Docker 构建自身的临时文件
# ============================================================
Dockerfile.dev
docker-compose.dev.yml
docker-compose.override.yml
.dockerignore.bak

